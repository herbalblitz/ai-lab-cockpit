<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:endColor="@color/fd_hero_end"
                android:startColor="@color/fd_hero_start"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="@color/fd_stroke" />
        </shape>
    </item>
    <item
        android:width="150dp"
        android:height="150dp"
        android:gravity="top|right"
        android:right="6dp"
        android:top="6dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#267C8CFF"
                android:endColor="#007C8CFF"
                android:gradientRadius="78dp"
                android:type="radial" />
        </shape>
    </item>
    <item
        android:width="90dp"
        android:height="90dp"
        android:gravity="bottom|left"
        android:left="10dp"
        android:bottom="6dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#1AB07CFF"
                android:endColor="#00B07CFF"
                android:gradientRadius="46dp"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
